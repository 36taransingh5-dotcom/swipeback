# Copy to .env.local and fill in. .env.local is gitignored; never commit or paste secrets.

# --- Database (optional) ---------------------------------------------------
# Unset = local embedded Postgres started with `corepack pnpm db:start` (port 54329).
# DATABASE_URL=postgres://user:pass@host:5432/swipeback

# --- Demo identities -------------------------------------------------------
# The dedicated finance mailbox Swipeback connects to (e.g. a new Gmail account).
SB_FINANCE_MAILBOX=
# The address the "employee" sends receipts from during the live demo.
SB_EMPLOYEE_EMAIL=
# The finance reviewer's address (receives approval requests and magic-link sign-in).
SB_REVIEWER_EMAIL=

# --- Gmail OAuth (Google Cloud: Gmail API enabled, consent screen External/Testing,
#     finance mailbox added as a test user, OAuth client type "Web application") ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# --- Extraction model ------------------------------------------------------
# Read explicitly by Swipeback; ambient ANTHROPIC_* shell variables are ignored on purpose.
SB_ANTHROPIC_API_KEY=
# llm (default when the key is set) | baseline (rule-only) | record (live + save cassettes) | replay (cassettes only)
# SB_EXTRACTOR=llm
# SB_EXTRACTION_MODEL=claude-opus-5-5
# SB_EXTRACTION_EFFORT=medium

# --- Secrets for tokens at rest --------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
SB_TOKEN_ENCRYPTION_KEY=

SB_APP_URL=http://localhost:3000
