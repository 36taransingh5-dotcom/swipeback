# Copy to .env.local and fill in. .env.local is gitignored; never commit or paste secrets.

# --- Database (optional) ---------------------------------------------------
# Unset = local embedded Postgres started with `corepack pnpm db:start` (port 54329).
# DATABASE_URL=postgres://user:pass@host:5432/swipeback

# --- Demo identities -------------------------------------------------------
# The dedicated finance mailbox Swipeback connects to (e.g. a new Gmail account).
SB_FINANCE_MAILBOX=
# The address the "employee" sends receipts from during the live demo.
SB_EMPLOYEE_EMAIL=
# The finance reviewer's address (receives approval requests and magic-link sign-in).
SB_REVIEWER_EMAIL=

# --- Gmail OAuth (Google Cloud: Gmail API enabled, consent screen External/Testing,
#     finance mailbox added as a test user, OAuth client type "Web application") ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
# Existing connected Gmail connection used to send new-workspace verification links.
# Select its channel_connections.id; never select a customer's mailbox implicitly.
SB_SIGNUP_CONNECTION_ID=

# --- Extraction model ------------------------------------------------------
# Provider: openai | anthropic | baseline (rule-only), or llm + SB_LLM_PROVIDER=openai|anthropic.
# Default: openai if SB_OPENAI_API_KEY is set, else anthropic if SB_ANTHROPIC_API_KEY, else baseline.
SB_EXTRACTOR=llm
SB_LLM_PROVIDER=openai
# Keys are read explicitly; ambient OPENAI_* / ANTHROPIC_* shell variables are ignored on purpose.
SB_OPENAI_API_KEY=
SB_OPENAI_MODEL=gpt-5.5
# SB_OPENAI_REASONING_EFFORT=medium
SB_ANTHROPIC_API_KEY=
# SB_EXTRACTION_MODEL=claude-opus-5-5
# SB_EXTRACTION_EFFORT=medium
# off (default) | record (live calls saved to eval/cassettes) | replay (no network)
# SB_CASSETTES=off

# --- Secrets for tokens at rest --------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
SB_TOKEN_ENCRYPTION_KEY=

# --- Local TrueLayer Data API sandbox card feed (never enabled on Vercel) ---
# Create a sandbox app with client id sandbox-swipeback-a13286 and allowlist
# http://localhost:3000/callback. Only the secret is read from this file.
TRUELAYER_CLIENT_SECRET=
# SB_TRUELAYER_POLL_SECONDS=28800

SB_APP_URL=http://localhost:3000

# --- Slack bot (Socket Mode; see docs/slack/SETUP.md) ---------------------------
# The adapter is registered only when SB_SLACK_BOT_TOKEN is set.
SB_SLACK_BOT_TOKEN=          # xoxb-… (Bot User OAuth Token)
SB_SLACK_APP_TOKEN=          # xapp-… (app-level token with connections:write), for Socket Mode
SB_SLACK_SIGNING_SECRET=     # only needed for the HTTP route; empty = HTTP Slack requests rejected

# --- iMessage via BlueBubbles (see docs/imessage/SETUP.md) ---------------------
# The adapter is registered only when SB_BLUEBUBBLES_URL is set.
SB_BLUEBUBBLES_URL=          # e.g. http://localhost:1234 (the BlueBubbles server)
SB_BLUEBUBBLES_PASSWORD=     # the server password
SB_BLUEBUBBLES_LABEL=        # the bot's Apple ID or number, used as the connection address

# Card-led receipt chase: minutes after a swipe before asking for the receipt; question reminder and expiry
# SB_RECEIPT_GRACE_MINUTES=60
# SB_QUESTION_REMINDER_MINUTES=1440
# SB_QUESTION_EXPIRY_MINUTES=1440
