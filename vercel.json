{
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build:vercel",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.ts": { "includeFiles": "{api/index.bundle.mjs,landing/**,certs/**}" }
  }
}
